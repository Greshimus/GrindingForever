* text=auto
*.lua text eol=lf
*.toc text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.cmd text eol=lf
*.tga binary
*.blp binary
*.ttf binary
*.png binary
*.jpg binary
# These are immutable upstream byte snapshots used by Git-blob validation.
/.gitattributes text eol=lf
tools/fishing-pools/sources/** -text
tools/fishing-pools/gatherradar/** -text
tools/fishing-pools/UPSTREAM-* -text
tools/fishing-pools/gpl-3.0.md -text
tools/fishing-pools/*LICENSE* -text
